# Copy to .env.local for local development. Never a required file — with
# nothing set, the app falls back to http://localhost:8000 (see
# app/api/[...path]/route.ts).

# Checkpoint I2: the browser never talks to the API's own host — every
# request goes through this app's same-origin proxy (app/api/[...path]/
# route.ts) at a relative /api/... path, which forwards it server-to-server
# to this URL. SERVER-ONLY: deliberately not NEXT_PUBLIC_-prefixed, so it's
# never inlined into the client bundle and can change without a rebuild.
GROUNDWORK_API_ORIGIN=http://localhost:8000
