# Copy to .env.local for local development. Never a required file — with
# nothing set, the app falls back to http://localhost:8000 (see lib/api.ts).

# Where the frontend reaches the API. NEXT_PUBLIC_-prefixed vars are
# inlined into the client bundle at BUILD time (`next build`), not read at
# request time — set this before building, and rebuild if it changes. No
# provider API key (OpenAI/Tavily/etc.) is ever NEXT_PUBLIC_-prefixed —
# those stay server-side in the API process only.
NEXT_PUBLIC_API_URL=http://localhost:8000
