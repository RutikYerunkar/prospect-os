# Groundwork environment configuration.
# Copy to .env and fill in only what you need — Demo Mode requires none of this.

# --- API (apps/api) ---

# demo (default, no external calls) | live (P1 — requires the keys below)
MODE=demo

# SQLite by default. Swappable to Postgres later without touching application code.
DATABASE_URL=sqlite+aiosqlite:///./groundwork.db

# Bounded concurrency for the prospect fan-out (see docs/ARCHITECTURE.md — Concurrency).
MAX_CONCURRENT_PROSPECTS=3
RUN_WALL_CLOCK_TIMEOUT_S=180

# Comma-separated list is not supported by pydantic-settings list parsing from env by
# default; leave this unset to use the built-in default (http://localhost:3000) unless
# you need another origin.
# CORS_ORIGINS=["http://localhost:3000"]

# --- Live Mode providers (Checkpoint G — optional, never required for the demo) ---
# Checkpoint G Live Mode is REAL OPENAI LLM + FIXTURE SEARCH ("LIVE LLM ·
# FIXTURE SEARCH") — no live web search yet (that's Checkpoint H).
OPENAI_API_KEY=
TAVILY_API_KEY=

# Model selection is config-only — no application code branches on this
# string. gpt-5.6-luna is the named lower-cost alternative profile.
OPENAI_MODEL=gpt-5.6-terra
# "" (empty) omits the `reasoning` field from the request entirely.
OPENAI_REASONING_EFFORT=low

# Cost/safety hard bounds (Checkpoint G §7) — provisional defaults, not
# secrets. See docs/PROGRESS.md for how LLM_MAX_OUTPUT_TOKENS was measured.
LIVE_MAX_PROSPECTS_PER_RUN=5
LLM_MAX_CONCURRENCY=2
LLM_MAX_TRANSPORT_RETRIES=2
LLM_MAX_SCHEMA_RETRIES=1
LIVE_STEP_TIMEOUT_S=45
LIVE_RUN_WALL_CLOCK_TIMEOUT_S=600
LLM_CALL_DEADLINE_S=30
LLM_MAX_OUTPUT_TOKENS=2048

# Pricing is NOT baked into code unless verified. Leave unset (blank, as
# below, or absent entirely) and cost_usd stays null everywhere (evaluation,
# llm_calls, the UI) — never guessed. Blank is explicitly safe: copying this
# file to .env verbatim and leaving these three blank will not crash the API
# (Settings normalizes a blank value to None before parsing it as a number).
OPENAI_PRICE_INPUT_USD_PER_MTOK=
OPENAI_PRICE_OUTPUT_USD_PER_MTOK=
# A SOFT spending threshold, never a hard cap. Only enforceable once pricing
# above is also configured (unpriced calls can't be measured against it).
LIVE_RUN_SOFT_BUDGET_USD=

# --- Web (apps/web) ---

# Where the frontend reaches the API. Defaults to http://localhost:8000 if unset.
NEXT_PUBLIC_API_URL=http://localhost:8000
