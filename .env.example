# Groundwork environment configuration.
# Copy to .env and fill in only what you need — Demo Mode requires none of this.

# --- API (apps/api) ---

# demo (default, no external calls) | live (P1 — requires the keys below)
MODE=demo

# development (default) | test | production. Never branches engine/domain
# behavior (see CLAUDE.md's invariants) — only process-level concerns:
# cookie Secure flag, opaque-vs-detailed error responses, log formatting.
ENVIRONMENT=development
LOG_LEVEL=INFO

# SQLite by default (local dev). Swappable to Postgres without touching
# application code — see docs/DEPLOYMENT.md for the full connection-string
# checklist (sslmode/channel_binding handling, asyncpg specifics).
#   sqlite+aiosqlite:///./groundwork.db          (local dev, default)
#   postgresql://user:pass@host:5432/dbname?sslmode=require   (managed Postgres)
DATABASE_URL=sqlite+aiosqlite:///./groundwork.db
# Ignored for the SQLite dialect. Small pool sized for ONE API instance /
# ONE uvicorn worker — see docs/DEPLOYMENT.md. Not PgBouncer-backed.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_PRE_PING=true

# Bounded concurrency for the prospect fan-out (see docs/ARCHITECTURE.md — Concurrency).
MAX_CONCURRENT_PROSPECTS=3
RUN_WALL_CLOCK_TIMEOUT_S=180

# Accepts EITHER a JSON list or a plain comma-separated string — see
# `config.py::_parse_cors_origins`. Leave unset to use the built-in default
# (http://localhost:3000) unless you need another origin.
# CORS_ORIGINS=http://localhost:3000,https://app.example.com

# --- Operator session (Live Mode gate) — Checkpoint I1 Phase 8 ---
# Live Mode is HARD-DISABLED unless BOTH of these are set. Never commit real
# values here; these are documentation placeholders only.
OPERATOR_PASSPHRASE=
# A long random string (e.g. `openssl rand -hex 32`). Signs the operator
# session cookie (itsdangerous URLSafeTimedSerializer). Unset -> operator
# session endpoints refuse to issue cookies even if a passphrase is set
# (fail closed, never an unsigned cookie).
SESSION_SIGNING_KEY=
# Optional — accepted for verification only, to rotate SESSION_SIGNING_KEY
# without invalidating every existing session immediately.
SESSION_SIGNING_KEY_OLD=
SESSION_MAX_AGE_S=43200
OPERATOR_LOGIN_RATE_LIMIT_ATTEMPTS=5
OPERATOR_LOGIN_RATE_LIMIT_WINDOW_S=60

# --- Live cost/abuse controls — Checkpoint I1 Phase 8B ---
LIVE_MAX_ACTIVE_RUNS=1
LIVE_DAILY_RUN_ALLOWANCE=10
# In-process, per-client-IP — correct for ONE API instance, NOT a
# distributed rate limit (see groundwork/api/rate_limit.py).
PUBLIC_WRITE_RATE_LIMIT_ATTEMPTS=30
PUBLIC_WRITE_RATE_LIMIT_WINDOW_S=60
PREVIEW_RATE_LIMIT_ATTEMPTS=120
PREVIEW_RATE_LIMIT_WINDOW_S=60
MAX_REQUEST_BODY_BYTES=256000

# --- Execution lease (ownership-safe run recovery) — Checkpoint I1 Phase 4 ---
EXECUTOR_HEARTBEAT_INTERVAL_S=10
EXECUTOR_STALE_THRESHOLD_S=60
EXECUTOR_REAPER_INTERVAL_S=30
SHUTDOWN_DRAIN_TIMEOUT_S=20

# --- Live Mode providers (optional, never required for the demo) ---
# H2 Live Mode is REAL OPENAI LLM + REAL TAVILY SEARCH ("LIVE LLM · LIVE
# SEARCH"). Live Mode requires BOTH keys below — configuring only one still
# leaves Live Mode unavailable (never a silent fixture-search fallback for
# either half). A historical Checkpoint G run (LIVE LLM · FIXTURE SEARCH)
# remains a truthful record of what actually executed at the time.
OPENAI_API_KEY=
TAVILY_API_KEY=

# Model selection is config-only — no application code branches on this
# string. gpt-5.6-luna is the named lower-cost alternative profile.
OPENAI_MODEL=gpt-5.6-terra
# "" (empty) omits the `reasoning` field from the request entirely.
OPENAI_REASONING_EFFORT=low

# Cost/safety hard bounds (Checkpoint G §7) — provisional defaults, not
# secrets. See docs/PROGRESS.md for how LLM_MAX_OUTPUT_TOKENS was measured.
LIVE_MAX_PROSPECTS_PER_RUN=5
LLM_MAX_CONCURRENCY=2
LLM_MAX_TRANSPORT_RETRIES=2
LLM_MAX_SCHEMA_RETRIES=1
LIVE_STEP_TIMEOUT_S=45
LIVE_RUN_WALL_CLOCK_TIMEOUT_S=600
LLM_CALL_DEADLINE_S=30
# H2 post-smoke: DISCOVERY_EXTRACTION reads far more source text in one
# call than any other Live LLM operation (up to 40 real search-result
# excerpts) — a real first smoke exhausted its transport-retry budget
# against the shared 30s deadline on exactly this operation. This gives it
# its own, larger deadline; every other operation keeps LLM_CALL_DEADLINE_S.
LLM_DISCOVERY_CALL_DEADLINE_S=60
LLM_MAX_OUTPUT_TOKENS=2048

# Pricing is NOT baked into code unless verified. Leave unset (blank, as
# below, or absent entirely) and cost_usd stays null everywhere (evaluation,
# llm_calls, the UI) — never guessed. Blank is explicitly safe: copying this
# file to .env verbatim and leaving these three blank will not crash the API
# (Settings normalizes a blank value to None before parsing it as a number).
OPENAI_PRICE_INPUT_USD_PER_MTOK=
OPENAI_PRICE_OUTPUT_USD_PER_MTOK=
# A SOFT spending threshold, never a hard cap. Only enforceable once pricing
# above is also configured (unpriced calls can't be measured against it).
LIVE_RUN_SOFT_BUDGET_USD=

# --- Live search hard bounds (H2 §3) — the real safety controls on real
# Tavily spend; a dollar bound is a nice-to-have (see pricing below), these
# call/query/result/extract caps are what's actually enforced, always. ---
LIVE_MAX_PLAN_QUERIES_PER_RUN=4
LIVE_MAX_DOMAIN_RESOLUTION_QUERIES_PER_RUN=8
LIVE_MAX_SOURCE_QUERIES_PER_PROSPECT=3
LIVE_MAX_SEARCH_CALLS_PER_RUN=32
SEARCH_MAX_TRANSPORT_RETRIES=1
LIVE_MAX_RESULT_OCCURRENCES_PER_PROSPECT=15
LIVE_MAX_SOURCES_PER_PROSPECT=5
LIVE_MAX_EXTRACT_CALLS_PER_RUN=25
LIVE_MAX_SEARCH_RESULTS_PER_QUERY=10
SEARCH_CALL_DEADLINE_S=20
SEARCH_MAX_CONCURRENCY=2
# Bounded persisted excerpt length for LIVE_FETCH source content — raw
# HTML/full page bodies are never persisted, only this bounded excerpt.
LIVE_MAX_SOURCE_EXCERPT_CHARS=1200
TAVILY_SEARCH_DEPTH=basic

# Tavily pricing is NOT baked into code unless verified/configured — unset
# (blank, as below) and search cost_usd stays null everywhere, exactly like
# the OpenAI pricing fields above; the UI shows "—", never "$0.00". There is
# no publicly-documented stable per-credit USD rate to hardcode here.
TAVILY_PRICE_USD_PER_CREDIT=

# --- V2-D/V2-DH: Live Apollo/Hunter contact enrichment (optional, never
# required) ---
# Selects which EnrichmentProvider slot Live Mode wires. "none" (default)
# means enrichment=None -> NOT_ATTEMPTED, zero provider calls — a perfectly
# valid, unrelated-to-cost choice. "apollo" requires APOLLO_API_KEY below;
# "hunter" requires HUNTER_API_KEY below. Without the matching key, starting
# a Live run 422s naming that key before the run is even created. A stray
# APOLLO_API_KEY/HUNTER_API_KEY with ENRICHMENT_PROVIDER=none (or set to the
# OTHER provider) activates nothing.
ENRICHMENT_PROVIDER=none
APOLLO_API_KEY=

APOLLO_CALL_DEADLINE_S=15
APOLLO_MAX_CONCURRENCY=2
APOLLO_MAX_TRANSPORT_RETRIES=1
# See MAX_ENRICHMENT_CALLS_PER_RUN above — the same per-run hard ceiling
# already used by Demo Mode's `EnrichmentCallBudget` applies here too.

# No verified numeric Apollo usage/credit field exists yet (see
# docs/PROGRESS.md) — this rate is never applied to a guessed credit count,
# so leaving it blank changes nothing until a future session confirms one.
APOLLO_PRICE_USD_PER_CREDIT=

# V2-DH: Hunter Email Finder — the second live EnrichmentProvider, behind
# the same Protocol Apollo satisfies. ENRICHMENT_PROVIDER=hunter requires
# this key.
HUNTER_API_KEY=

HUNTER_CALL_DEADLINE_S=15
HUNTER_MAX_CONCURRENCY=2
HUNTER_MAX_TRANSPORT_RETRIES=1
# No HUNTER_PRICE_USD_PER_CREDIT — deliberately not offered (frozen plan);
# credits_used/cost_usd stay permanently null for every Hunter attempt.

# --- Web (apps/web) ---

# Where the frontend reaches the API. Defaults to http://localhost:8000 if unset.
NEXT_PUBLIC_API_URL=http://localhost:8000
